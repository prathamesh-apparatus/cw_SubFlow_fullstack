# SubFlow runs entirely inside Next.js now — UI + API on ONE port.
# The browser calls the API on the same origin:
NEXT_PUBLIC_API_URL=/api

# --- Server-only settings (read by the Next.js API routes; never exposed to the browser) ---
# PostgreSQL (started by docker-compose.yml, which reads THIS file)
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=subflow
DATABASE_USER=subflow
DATABASE_PASSWORD=

# Session JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Single admin account (auto-seeded on first login when the admins table is empty;
# or run `npm run seed` to create/update it explicitly)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public URL of this app (used for links inside notification emails)
FRONTEND_URL=http://localhost:3001

# Email notifications via Nodemailer (SMTP) — leave SMTP_HOST/SMTP_USER/SMTP_PASS empty to skip emails.
# For Gmail, SMTP_HOST=smtp.gmail.com and SMTP_PASS must be a Google App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SubFlow
